<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="saas_service.SaasPasswordField">
        <div class="o_field_saas_password d-flex align-items-center gap-1 w-100">
            <input class="o_input flex-grow-1" t-att-type="inputType" t-att-value="value" readonly="readonly"/>
            <button type="button"
                    class="btn btn-light border px-2"
                    t-on-click="toggleVisibility"
                    t-att-title="state.visible ? 'مخفی کردن رمز' : 'نمایش رمز'"
                    t-att-aria-label="state.visible ? 'مخفی کردن رمز' : 'نمایش رمز'">
                <i t-att-class="state.visible ? 'fa fa-eye-slash' : 'fa fa-eye'"/>
            </button>
        </div>
    </t>
</templates>
