<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_saas_odoo_module_list" model="ir.ui.view">
        <field name="name">saas.odoo.module.list</field>
        <field name="model">saas.odoo.module</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="technical_name"/>
                <field name="category"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_saas_odoo_module" model="ir.actions.act_window">
        <field name="name">کاتالوگ ماژول‌ها</field>
        <field name="res_model">saas.odoo.module</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
