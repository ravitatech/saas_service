<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_saas" model="ir.ui.view">
        <field name="name">sale.order.form.saas.service</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="سرویس SaaS" name="saas_service">
                    <group>
                        <field name="saas_hostname"/>
                        <field name="saas_service_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
